# Copy to .env and fill in local values. Never commit the real .env file.

APP_ENV=local
LOG_LEVEL=INFO

# Local dev: native Windows PostgreSQL install (Postgres 18 + pgvector 0.8.6),
# not the docker-compose stack — see docs/architecture.md "Local development" section.
DATABASE_URL=postgresql+asyncpg://agentic_rag_app:agentic_rag_dev_pw@localhost:5432/agentic_rag

# Local dev: managed free-tier Redis (e.g. Upstash). Replace with your instance's
# connection string once you have one. In docker-compose/CI this instead points
# at the redis service. Left as this placeholder, storage/cache.py falls back to
# an in-process InMemoryCache automatically (no external account required).
REDIS_URL=rediss://default:<password>@<your-upstash-endpoint>:6379

# Provider selection — see embeddings/providers.py, generation/llm.py, retrieval/reranking.py.
# "mock" requires no external service or API key and is the default for local dev/tests.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
RERANKER_PROVIDER=mock

# Only needed if the corresponding provider above is set to a real backend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Agentic loop budgets — see core/config.py
MAX_RETRIEVAL_ITERATIONS=3
MAX_RETRIEVAL_CALLS=8
MAX_TOKENS_PER_QUERY=8000
MAX_QUERY_LATENCY_SECONDS=60
